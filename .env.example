# =============================================================================
# MAME — Environment Variables Template
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git
# =============================================================================

# --- Database (Neon or local Docker) ---
DATABASE_URL=postgresql://mame_dev:mame_dev_password@localhost:5432/mame_dev

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
CLERK_WEBHOOK_SECRET=whsec_xxxx
CLERK_JWT_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWT_AUDIENCE=mame-api

# --- Cloudinary (Evidence Storage) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Resend (Email — admin alerts only) ---
RESEND_API_KEY=re_xxxx

# --- Sentry (Error Monitoring) ---
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.us.sentry.io/xxxx
SENTRY_DSN_BACKEND=https://xxxx@xxxx.ingest.us.sentry.io/xxxx

# --- Encryption Keys (generate with: node scripts/generate-encryption-keys.ts) ---
ENCRYPTION_MASTER_KEY=generate_me_64_bytes_hex
ENCRYPTION_RELATION_KEY=generate_me_64_bytes_hex

# --- App Config ---
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
